-function saveCmt(id){const ta=document.getElementById('ta-'+id);if(ta){const v=ta.value.trim();if(v)S.comments[id]=v;else delete S.comments[id];}S.editing=null;render();}
-function cancelCmt(){const id=S.editing;if(id&&!S.comments[id])delete S.comments[id];S.editing=null;renderDiff();}
-function delCmt(id){delete S.comments[id];S.editing=null;render();}
-function clearAll(){
-  S={files:[],active:0,comments:{},editing:null,reviewed:{},reverted:{},focus:true,collapse:false,expanded:{}};
-  document.getElementById('paste-overlay').classList.remove('hidden');
-  document.getElementById('ctx-bar').style.display='none';
-  document.getElementById('col-labels').style.display='none';
-  document.getElementById('diff-scroll').style.display='none';
-  document.getElementById('progress-strip').classList.remove('active');
-  document.getElementById('float-bar').classList.remove('active');
-  render();
-}
-function showToast(m){const t=document.getElementById('toast');t.textContent=m;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),1800);}
-function esc(s){return s?s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;'):''}
-
-document.addEventListener('keydown',(e)=>{
-  if(e.target.tagName==='TEXTAREA'){if(e.key==='Escape')cancelCmt();if((e.metaKey||e.ctrlKey)&&e.key==='Enter'&&S.editing){e.preventDefault();saveCmt(S.editing);}return;}
-  if(!S.files.length)return;
-  if(e.key==='ArrowRight'&&S.active<S.files.length-1)sel(S.active+1);
-  if(e.key==='ArrowLeft'&&S.active>0)sel(S.active-1);
-  if(e.key==='f')toggleFocusMode();
-  if(e.key==='c')toggleCollapseContext();
-  if(e.key==='r')rev(S.active);
-  if(e.key==='u')undoRev(S.active);
-  if(e.key==='Escape')cancelCmt();
-});
-
-document.addEventListener('paste',(e)=>{
-  if(e.target.tagName==='TEXTAREA')return;
-  const t=e.clipboardData.getData('text');if(!t||!t.includes('diff --git'))return;
-  e.preventDefault();
-  S.files=parseDiff(t);S.active=0;S.comments={};S.editing=null;S.reviewed={};S.reverted={};S.expanded={};
-  document.getElementById('paste-overlay').classList.add('hidden');render();
-});
-
-render();
-</script>
-</body>
-</html>
